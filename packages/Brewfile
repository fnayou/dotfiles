# Cross-platform tools — install with: brew bundle --file=packages/Brewfile
# Works on macOS and on Linux (Homebrew on Linux).
# For Arch / EndeavourOS see: packages/arch/packages.txt
# For Debian (stable / trixie) see: packages/debian/packages.txt
#
# Note: zinit is NOT listed here. Install via one-time manual git clone.
# See: docs/guides/packages-setup.md

# --- Repository prerequisites ---
brew "git"
brew "stow"
brew "go-task", tap: "go-task/tap"

# --- Changelog tooling ---
# Only needed to run `task changelog`, which regenerates CHANGELOG.md from
# Conventional Commits. See: docs/decisions/0055-git-cliff-changelog-generation.md
brew "git-cliff"

# --- Shell runtime (zsh) ---
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"
brew "oh-my-posh", tap: "jandedobbeleer/oh-my-posh"

# --- Neovim ---
# node + python power the LSP servers Mason installs inside Neovim.
# A C compiler (Xcode Command Line Tools) is also required for treesitter
# parsers — install separately with: xcode-select --install
# nvim-treesitter (main branch) needs the tree-sitter CLI, which Homebrew's
# `tree-sitter` formula does NOT provide (library only). Install the CLI with:
#   npm install -g tree-sitter-cli
brew "neovim"
brew "ripgrep"
brew "fd"
brew "node"
brew "python"
brew "pipx"

# --- System monitor ---
brew "btop"

# --- Network speed test ---
# Optional — powers the `speed` / `speed-json` / `speed-log` helpers in the zsh package.
# Homebrew core formula: no tap required.
# See: docs/guides/speedtest-setup.md
brew "cloudflare-speed-cli"

# --- Image preview ---
# Optional — lets `cat` and image suffix aliases in the zsh package show images.
brew "chafa"

# --- Generated art (PNG rendering) ---
# Optional — `task art:build` renders a PNG beside each generated SVG with rsvg-convert.
# The SVGs and `task art:check` need only Python 3. See: docs/guides/art-setup.md
brew "librsvg"

# --- Terminal workspace manager ---
# Optional — only needed if you stow the `herdr` package.
# Not in the official Arch repos or the Debian archive; Homebrew carries it on
# macOS, Arch and Debian alike. Arch users may prefer the AUR package instead.
# See: docs/guides/herdr-setup.md
brew "herdr"

# --- AI coding agent token optimizer ---
# Optional — rewrites common dev commands so agents read less output.
# Homebrew core formula: no tap required. Some filters shell out to ripgrep,
# already listed above.
# ⚠️  Two unrelated projects are named `rtk`. This is rtk-ai/rtk (Rust Token
# Killer). Verify with `rtk gain`, which only the correct one provides.
# Activation is a separate per-agent step — brew only installs the binary.
# See: docs/guides/agent-tooling-setup.md
brew "rtk"

# Not installable via Homebrew — see docs/guides/agent-tooling-setup.md:
#   caveman           — installer script (JuliusBrussee/caveman)
#   mattpocock/skills — `npx skills` into the shared ~/.agents/skills/ directory
