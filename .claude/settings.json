{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/art-reminder.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/art-reminder.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/art-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
